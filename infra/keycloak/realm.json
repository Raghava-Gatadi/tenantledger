{
  "realm": "tenantledger",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "bruteForceProtected": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "tenantledger-web",
      "name": "TenantLedger",
      "enabled": true,
      "publicClient": false,
      "secret": "local-web-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*"
      },
      "protocolMappers": [
        {
          "name": "ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tenantledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ledger-test",
      "name": "Local integration tests ONLY",
      "enabled": true,
      "publicClient": false,
      "secret": "local-test-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "tenantledger-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "tenantledger-api",
      "name": "TenantLedger API introspection",
      "enabled": true,
      "publicClient": false,
      "secret": "local-api-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
